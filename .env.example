# ==============================================================================
# Enterprise Attack Detection & Response Lab - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides if needed (never commit .env).
# All values below represent safe local lab defaults.

# Lab General Settings
LAB_ENVIRONMENT=development
LAB_NAME="Enterprise Attack Detection & Response Lab"
LAB_LOG_LEVEL=INFO

# Network Configuration (Subnet CIDRs)
NET_SIMULATION_CIDR=172.28.10.0/24
NET_CORP_INTERNAL_CIDR=172.28.20.0/24
NET_APP_TIER_CIDR=172.28.30.0/24
NET_SECMON_CIDR=172.28.90.0/24

# Active Directory Domain Configuration
AD_DOMAIN_NAME=CORP.ENTERPRISE.LOCAL
AD_NETBIOS_NAME=CORP
AD_DC_HOSTNAME=dc01.corp.enterprise.local
AD_DC_IP=172.28.20.10
AD_LDAP_PORT=389
AD_LDAPS_PORT=636
AD_KERBEROS_PORT=88

# Linux Server Configuration
LINUX_SRV_HOSTNAME=linux-srv01.corp.enterprise.local
LINUX_SRV_IP=172.28.20.15
LINUX_SSH_PORT=2222

# Application Tier Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DB_URL=sqlite:///./data/app_portal.db
APP_SECRET_KEY=lab-development-insecure-key-do-not-use-in-prod

# SIEM & Centralized Telemetry Collector Configuration
SIEM_HOST=0.0.0.0
SIEM_HTTP_PORT=8088
SIEM_SYSLOG_UDP_PORT=5514
SIEM_SYSLOG_TCP_PORT=5514
SIEM_STORAGE_BACKEND=memory
