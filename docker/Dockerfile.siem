FROM python:3.12-slim

WORKDIR /app

RUN groupadd -g 10001 appuser && useradd -u 10001 -g appuser -s /sbin/nologin -d /app appuser

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8088 5514/udp

CMD ["python3", "-m", "uvicorn", "src.siem.app:app", "--host", "0.0.0.0", "--port", "8088"]

